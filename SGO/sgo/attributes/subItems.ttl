@prefix ogit:                   <http://www.purl.org/ogit/> .
@prefix owl:                    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:                <http://purl.org/dc/terms/> .

ogit:subItems
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "subItems";
	dcterms:description """The enumerated constituent items an element comprises,
	as a list. Unlike subType, subCategory and subClass, which classify the
	element itself, this attribute enumerates its parts. Use it where the parts
	carry no attributes, edges or classification of their own and are therefore
	not worth separate vertices; where they do, model them as vertices and relate
	them with a verb instead. OGIT has no native list datatype, so the encoding is
	declared by the entity using the attribute -- one entry per line where the
	entries are only read, a JSON array where a consumer has to address or count
	them individually.""";
	dcterms:valid "start=2026-08-20;";
	dcterms:creator "Almato AG";
.
